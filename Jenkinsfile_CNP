#!groovy

@Library("Infrastructure@2.4.4")

import uk.gov.hmcts.contino.AppPipelineConfig

// Temporary Stage A safety hold: allow PR preview/plan evidence; block master, environment and unknown branches.
if (!(env.BRANCH_NAME ==~ /^PR-\d+$/)) {
  error('EXUI-5084 Stage A hold: destination deployment is disabled until authority transfers from em-icp-api.')
}

properties([
  [
    $class       : 'GithubProjectProperty',
    displayName  : 'Presenting Evidence Digitally Backend API',
    projectUrlStr: 'https://github.com/hmcts/rpx-xui-icp-api'
  ],
  pipelineTriggers([
    [$class: 'GitHubPushTrigger']
  ])
])

def type = "nodejs"
// Prepare the XUI pipeline identity behind the temporary deployment hold above.
def product = "xui"
def component = "icp-api"
def channel = '#xui-pipeline'

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [$class     : 'AzureKeyVaultSecret',
   secretType : 'Secret',
   name       : secretName,
   envVariable: envVar
  ]
}

def secrets = [
  's2s-${env}': [
    secret('microservicekey-em-gw', 'FUNCTIONAL_TEST_CLIENT_S2S_TOKEN')
  ],
  'rpa-${env}': [
    secret('show-oauth2-token', 'FUNCTIONAL_TEST_CLIENT_OAUTH_SECRET')
  ],
  'em-icp-${env}': [
    secret('em-icp-web-pubsub-primary-connection-string', 'WEB_PUBSUB_PRIMARY_CONN_STRING')
  ]
]


// Vars for Kubernetes
env.IDAM_API_BASE_URL = 'https://idam-api.aat.platform.hmcts.net'
env.IDAM_WEBSHOW_WHITELIST = 'https://em-show-aat.service.core-compute-aat.internal/oauth2/callback'

//def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)

def pipelineConf = new AppPipelineConfig()
pipelineConf.vaultSecrets = secrets

def branchesToSync = ['demo','ithc','perftest']

withPipeline(type, product, component) {
  loadVaultSecrets(secrets)
  enableSlackNotifications(channel)
  disableLegacyDeployment()
//  after('build') {
//    yarnBuilder.yarn('build')
//  }
  syncBranchesWithMaster(branchesToSync)
}
