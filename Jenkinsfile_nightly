#!groovy

@Library("Infrastructure@2.4.4") _

// Temporary Stage A safety hold: nightly cannot run until deployment authority has transferred.
error('EXUI-5084 Stage A hold: destination nightly is disabled until authority transfers from em-icp-api.')

properties([
[
  $class       : 'GithubProjectProperty',
  displayName  : 'Presenting Evidence Digitally Backend API',
  projectUrlStr: 'https://github.com/hmcts/rpx-xui-icp-api'
],
// H allow predefined but random minute see https://en.wikipedia.org/wiki/Cron#Non-standard_characters
pipelineTriggers([cron('H 8 * * 1-5')])])

def type = "nodejs"
// Prepare the XUI pipeline identity behind the temporary deployment hold above.
def product = "xui"
def component = "icp-api"
def channel = '#xui-pipeline'

env.TEST_URL= "http://em-icp-aat.service.core-compute-aat.internal"
env.IDAM_API_BASE_URL= "https://idam-api.aat.platform.hmcts.net"
env.IDAM_S2S_URL= "http://rpe-service-auth-provider-aat.service.core-compute-aat.internal"
env.IDAM_WEBSHOW_WHITELIST = 'https://em-show-aat.service.core-compute-aat.internal/oauth2/callback'
env.REDIS_HOST= "em-icp-redis-cache-aat.redis.cache.windows.net"
env.REDIS_PORT= 6380

def secrets = [
  's2s-${env}': [
    secret('microservicekey-em-gw', 'FUNCTIONAL_TEST_CLIENT_S2S_TOKEN')
  ],
  'rpa-${env}': [
    secret('show-oauth2-token', 'FUNCTIONAL_TEST_CLIENT_OAUTH_SECRET')
  ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [ $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar
  ]
}

withNightlyPipeline(type, product, component) {
  loadVaultSecrets(secrets)
  enableSlackNotifications(channel)
//  enableCrossBrowserTest()
//  enableSecurityScan()
  enableFullFunctionalTest(200)
}
